## Managed by Ansible (python_app_platform role) - do not edit manually.
##
## Instantiated systemd service for hosting a Python ASGI application
## (e.g. FastAPI/uvicorn) as a plain systemd unit, without Docker.
##
## Usage:
##   1. Deploy application code to {{ python_app_platform_base_dir }}/<app-name>/
##   2. Create a virtualenv at {{ python_app_platform_base_dir }}/<app-name>/.venv
##      containing the app and an ASGI server (e.g. `pip install uvicorn`).
##   3. Create an environment file at
##      {{ python_app_platform_base_dir }}/<app-name>/.env defining at least:
##        APP_MODULE=package.module:app
##        PORT=8000
##   4. Make sure the {{ python_app_platform_system_user }} user can read the
##      app directory (chown -R {{ python_app_platform_system_user }}:{{ python_app_platform_system_group }}).
##   5. systemctl enable --now {{ python_app_platform_systemd_unit_name }}@<app-name>.service
##
## Point an nginx reverse-proxy vhost (see the reverse_proxy role) at
## 127.0.0.1:<PORT> to expose the app publicly.
[Unit]
Description=Python application (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ python_app_platform_system_user }}
Group={{ python_app_platform_system_group }}
WorkingDirectory={{ python_app_platform_base_dir }}/%i
EnvironmentFile={{ python_app_platform_base_dir }}/%i/.env
ExecStart=/bin/sh -c '"{{ python_app_platform_base_dir }}/%i/.venv/bin/uvicorn" "$APP_MODULE" --host 127.0.0.1 --port "$PORT"'
Restart=on-failure
RestartSec=5
UMask=0027

# Sandboxing / hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ python_app_platform_base_dir }}/%i
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
