## Managed by Ansible (app_deploy role) - do not edit manually.
##
## Path-routed reverse-proxy location block for the "{{ app_name }}"
## application, included by the shared gateway server block installed by
## the reverse_proxy role (see /etc/nginx/conf.d/10-app-gateway.conf).
##
## NOTE: this is a simple path-prefix proxy. The upstream app is not told
## about the "/{{ app_name }}" prefix (no root_path/X-Forwarded-Prefix
## support), so absolute links generated by the app itself (e.g. /docs,
## /openapi.json) may not resolve correctly through this prefix. The plain
## JSON endpoints (/, /health) are unaffected.
location /{{ app_name }}/ {
    proxy_pass http://127.0.0.1:{{ app_deploy_port }}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
